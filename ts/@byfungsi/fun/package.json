{
  "name": "@byfungsi/fun",
  "version": "0.1.0",
  "description": "AI-friendly version control for tracking AI file changes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "native"
  ],
  "scripts": {
