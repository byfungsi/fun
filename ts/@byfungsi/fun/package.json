  },
  "homepage": "https://github.com/byfungsi/fun#readme",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/bun": "^1.0.0"
  },
  "peerDependencies": {
